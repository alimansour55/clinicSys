{
  "name": "clinic-sys",
  "type": "module",
  "private": true,
  "description": "Clinivo monorepo test runner",
  "scripts": {
    "env:init": "node scripts/init-env.js",
    "test": "npm run test --prefix backend && npm run test --prefix frontend && npm run test --prefix admin",
    "test:integration": "npm run test:integration --prefix backend",
    "test:all": "npm test && npm run test:integration",
    "mobile:firewall": "powershell -ExecutionPolicy Bypass -File ./scripts/enable-mobile-access.ps1",
    "mobile:urls": "node ./scripts/lan-ip.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
