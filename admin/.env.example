# Local dev on this PC (browser at http://localhost:5174)
VITE_BACKEND_URL=http://localhost:4000

# Mobile / tablet on same Wi-Fi: open http://YOUR_PC_IP:5174 in the phone browser.
# The app auto-calls http://YOUR_PC_IP:4000 — no need to change this file if you use the LAN IP in the browser URL.
# Ensure backend is running: cd backend && npm run server
