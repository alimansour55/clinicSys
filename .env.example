# =============================================================================
# Clinivo — single source of truth (repo root)
# Copy to .env for local development:
#   cp .env.example .env
# Production overrides: copy .env.prod.example to .env.prod
# =============================================================================

APP_ENV=development

# --- Public URLs (patient + staff apps call this API) ---
API_PUBLIC_URL=http://localhost:4000
VITE_BACKEND_URL=http://localhost:4000

# --- Branding ---
APP_DISPLAY_NAME=Clinivo
VITE_APP_DISPLAY_NAME=Clinivo
PUBLIC_APP_BRAND=Clinivo

# --- CORS (comma-separated; used by backend) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Backend server ---
PORT=4000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/clinivo

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_secret

ADMIN_EMAIL=admin@yourclinic.com
ADMIN_PASSWORD=change_me_admin_password

# --- Cloudinary ---
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# --- Email (pick one setup) ---
SENDER_EMAIL=
APP_PASSWORD=
EMAIL_SERVICE=gmail

# Microsoft OAuth (optional)
# EMAIL_SERVICE=outlook
# MICROSOFT_TENANT=common
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REFRESH_TOKEN=
# MICROSOFT_SMTP_HOST=smtp-mail.outlook.com
# MICROSOFT_SMTP_PORT=587

# Custom SMTP (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=egp
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Teleconsultation ---
TELECONSULTATION_BASE_URL=https://meet.ffmuc.net
# Older name, read only when TELECONSULTATION_BASE_URL is empty
# JITSI_SERVER_URL=

# --- Twilio (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# --- OpenAI chatbot (patient booking assistant) and admin content translation ---
OPENAI_API_KEY=
# Model for the chatbot and translation. Leave empty for the built-in default (gpt-6-luna).
OPENAI_CHATBOT_MODEL=
# Older fallback, read only when OPENAI_CHATBOT_MODEL is empty
# OPENAI_MODEL=
# Set to false to turn AI off; the rule-based assistant still answers
CHATBOT_AI_ENABLED=true
# Caps on AI calls (0 or more). Defaults: 15 per IP per hour, 1000 per day, 15000 per month
CHATBOT_AI_PER_IP_PER_HOUR=15
CHATBOT_AI_PER_DAY=1000
CHATBOT_AI_PER_MONTH=15000

# --- Translation (optional) ---
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# --- Misc ---
CURRENCY_LABEL=EGP
# IANA zone the clinics run in. Booking "is this slot past" checks use it, not the server zone.
CLINIC_TIME_ZONE=Africa/Cairo
ACCOUNT_VERIFY_OTP_MINUTES=10
