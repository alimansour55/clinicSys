# =============================================================================
# Production overrides (repo root)
# Copy to .env.prod — loaded after .env when APP_ENV=production, on Vercel,
# or when building frontends with: npm run build
#   cp .env.prod.example .env.prod
# =============================================================================

APP_ENV=production

# Live API host (no :4000 — Vercel uses HTTPS on 443)
# Example: https://clinic-sys-eight.vercel.app
API_PUBLIC_URL=https://clinic-sys-eight.vercel.app
VITE_BACKEND_URL=https://clinic-sys-eight.vercel.app

# Backend CORS (only needed if a frontend calls the API host directly, not via /api proxy)
CORS_ORIGINS=https://clinic-sys-m878.vercel.app,https://admin-zeta-one-45.vercel.app,https://www.clinivo.shop,https://clinivo.shop,https://admin.clinivo.shop

# Use production MongoDB, secrets, Stripe live keys, etc.
# MONGODB_URI=
# JWT_SECRET=
# STRIPE_SECRET_KEY=sk_live_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
