# =============================================================================
# Production overrides (repo root)
# Copy to .env.prod — loaded after .env when APP_ENV=production, on Vercel,
# or when building frontends with: npm run build
#   cp .env.prod.example .env.prod
# =============================================================================

APP_ENV=production

# Live API (no :4000 on Vercel — HTTPS uses port 443)
API_PUBLIC_URL=https://YOUR-API.vercel.app
VITE_BACKEND_URL=https://YOUR-API.vercel.app

# Deployed frontends (comma-separated, no spaces)
CORS_ORIGINS=https://YOUR-PATIENT.vercel.app,https://YOUR-STAFF.vercel.app

# Use production MongoDB, secrets, Stripe live keys, etc.
# MONGODB_URI=
# JWT_SECRET=
# STRIPE_SECRET_KEY=sk_live_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
